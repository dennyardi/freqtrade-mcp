[Unit]
Description=Freqtrade MCP Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/freqtrade-mcp
EnvironmentFile=/opt/freqtrade-mcp/.env
ExecStart=/opt/freqtrade-mcp/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000 --log-level info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
